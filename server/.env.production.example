# Template for the production environment file. The real
# server/.env.production is NOT committed — the deploy workflow materializes
# it on the VM from the PROD_ENV_B64 secret stored in the GitHub
# "production" environment:
#   base64 < server/.env.production | gh secret set PROD_ENV_B64 --env production
# Placeholder values only (no secrets), so the template itself is teachable.
PORT=4000
NODE_ENV=production
LOG_LEVEL=info
SQLITE_PATH=data/guide.db

# MONGO_URI stays unset in this FILE on purpose — the prod compose supplies
# the service-name URI (mongodb://mongo:27017/express_guide_prod) via its
# environment: block, which beats env_file. The file keeps the default
# honest: no compose, no mongo.
