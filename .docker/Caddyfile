# REFERENCE site definition — retained for teaching, NOT shipped to the
# VM: nothing in this repo transfers or mounts it. The LIVE site block
# lives in the infra repo's shared caddy (/opt/caddy/conf.d/edg.caddy on
# the VM), which imports its own read-only bind mount of the one-line flip
# file (upstream.caddy, written by the deploy). A release flips that file
# and activates it with a graceful
# `docker exec caddy caddy reload --config /etc/caddy/Caddyfile` — no TLS
# blip, in-flight requests drain.
expressdevelopersguide.duckdns.org {
    import /etc/caddy/upstream.caddy
}
