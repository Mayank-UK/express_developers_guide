# ---- build stage: compile TypeScript (dev deps never leave this stage) ----
# CROSS-COMPILE: $BUILDPLATFORM is a BuildKit automatic resolving to the
# machine RUNNING the build, whatever --platform the final image targets —
# npm ci and tsc run on the builder's native CPU, never under QEMU. Safe
# because tsc's output is plain JavaScript and this stage's node_modules die
# with the stage: nothing arch-specific escapes it.
FROM --platform=$BUILDPLATFORM node:22-alpine AS build
# better-sqlite3 is a NATIVE module, and npm's legacy binding.gyp default
# runs `node-gyp rebuild` at install (the package ships no install script —
# the default still fires). Without python3/make/g++ that step FAILS and
# takes npm ci with it ("gyp ERR! find Python" on a bare node:22-alpine,
# verified). The runtime binary is the bundled musl prebuild either way, but
# the install itself must succeed — so the toolchain lives in the BUILD
# stages only.
RUN apk add --no-cache python3 make g++
WORKDIR /app
COPY server/package*.json ./
RUN npm ci
COPY server/tsconfig.json ./
COPY server/src ./src
RUN npm run build

# ---- prod-deps stage: install PRODUCTION deps on the BUILDER'S CPU ----
# CROSS-COMPILED now too, deliberately. better-sqlite3 v13 ships NO install
# script and BUNDLES per-platform N-API prebuilds inside the npm tarball
# (node_modules/better-sqlite3/prebuilds/ carries linuxmusl-arm64.node,
# linuxmusl-x64.node, and the rest), and its runtime loader PREFERS the
# bundled prebuild over any build/Release output — so `npm ci --omit=dev`
# executes nothing that must run on the target CPU (and needs no
# --ignore-scripts: there is no install script to silence). Running it on
# $BUILDPLATFORM keeps the WHOLE server build QEMU-free — the emulated leg
# once crashed right here on an amd64 runner ("qemu: uncaught target
# signal 4", npm ci under arm64 emulation). The case-assertion below keeps
# the old safety property fail-loud: a wrong-arch node_modules can never
# ship silently — every install must prove the target's musl prebuild
# is present.
FROM --platform=$BUILDPLATFORM node:22-alpine AS prod-deps
ARG TARGETPLATFORM
# Toolchain stays (seconds, native, zero QEMU): npm's legacy binding.gyp
# default still fires `node-gyp rebuild` here, and node-gyp will not even
# start without python3 (make/g++ cover the fallback compile path).
RUN apk add --no-cache python3 make g++
WORKDIR /app
COPY server/package*.json ./
# Cache mount: the now-always-native install reuses the npm download cache
# across builds instead of re-fetching every cold run.
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev && \
    case "$TARGETPLATFORM" in \
      linux/arm64) test -f node_modules/better-sqlite3/prebuilds/linuxmusl-arm64.node || { echo 'FAIL: linuxmusl-arm64 prebuild missing'; exit 1; } ;; \
      linux/amd64) test -f node_modules/better-sqlite3/prebuilds/linuxmusl-x64.node || { echo 'FAIL: linuxmusl-x64 prebuild missing'; exit 1; } ;; \
      *) echo "FAIL: unsupported TARGETPLATFORM: $TARGETPLATFORM"; exit 1 ;; \
    esac

# ---- runtime stage: node + built artifacts, NO compilers in the image ----
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
# node_modules comes from the prod-deps stage — installed against this same
# base image. The better-sqlite3 binding that actually loads at runtime is
# the package's bundled prebuilds/linuxmusl-arm64.node (verified: the shipped
# image has no build/Release binding, and the module still answers /api/posts).
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
EXPOSE 4000
CMD ["node", "dist/server.js"]
