node_modules/
dist/
*.log
server/data/
# Vitest HTML coverage report (server: npm run test:coverage)
coverage/
.DS_Store
# Playwright E2E artifacts (e2e/node_modules is covered by node_modules/ above)
e2e/test-results/
e2e/playwright-report/
# Env files stay out of git — EXCEPT this guide's teaching files, which
# contain only placeholders/local URLs and ARE the environments topic's
# example (negations must come after the rule; the parent server/ dir is not
# excluded, so re-including files under it works). The production file is a
# committed TEMPLATE (.example); the real server/.env.production stays
# untracked and is materialized on the VM at deploy time.
.env*
!server/.env.development
!server/.env.staging
!server/.env.production.example
# Client build-env template (Vite Umami vars — placeholders only, public by
# design; see client/src/ui/analytics/analytics.ts).
!client/.env.example
# Compose auto-loads this (project dir = first -f file's dir) so the CI
# override flow runs bare: compose interpolates each file BEFORE merging, so
# the :ci image override alone cannot silence ${IMAGE_TAG:?} in the prod
# file. Not a secret — one interpolation variable. An explicit IMAGE_TAG in
# the environment (the prod runbook) always wins over this file.
!.docker/.env
