# Build-time environment for Vite (copy to .env for local builds — the dev
# server and tests read it too). Everything here is PUBLIC by design: these
# values are baked into the served bundle.

# Self-hosted Umami analytics. BOTH must be non-empty to enable it; leaving
# either empty is the default and means analytics is a complete no-op (no
# script injected, track() sends nothing). Production builds get these as
# Docker build-args from the VITE_UMAMI_* repository variables in CI.
#VITE_UMAMI_SRC=https://umami.mayankcodeworks.com/script.js
VITE_UMAMI_SRC=
VITE_UMAMI_ID=

# Grafana Faro browser-crash telemetry canary (CDN IIFE bundle — no npm
# dependency). BOTH must be non-empty to enable it; leaving either empty is
# the default and means the beacon is a complete no-op (no script injected,
# nothing initialized). Production builds get these as Docker build-args
# from the VITE_FARO_* repository variables in CI.
#VITE_FARO_URL=https://faro.mayankcodeworks.com/collect
VITE_FARO_URL=
VITE_FARO_APP=
